<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ir.emaroid.hesab"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!-- تنها مجوز: اینترنت (آمارگیر EmaRoid) — بدون IMEI/تلفن/مکان -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="ماشین‌حساب EmaRoid"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar" >
        <activity
            android:name="ir.emaroid.hesab.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="ir.emaroid.hesab.HomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="ir.emaroid.hesab.HesabActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="ir.emaroid.hesab.RasmActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="ir.emaroid.hesab.HalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="ir.emaroid.hesab.AdadActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="ir.emaroid.hesab.AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>